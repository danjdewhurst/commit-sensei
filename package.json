{
  "name": "commit-sensei",
  "version": "1.0.0",
  "description": "Offline deterministic conventional commit message generator",
  "type": "commonjs",
  "bin": {
    "commit-sensei": "bin/commit-sensei.js"
  },
  "scripts": {
    "test": "node --test",
    "test:bun": "bun test",
    "sensei": "node ./bin/commit-sensei.js",
    "sensei:dry": "node ./bin/commit-sensei.js --dry-run",
    "sensei:bun": "bun run ./bin/commit-sensei.js",
    "sensei:bun:dry": "bun run ./bin/commit-sensei.js --dry-run"
  },
  "engines": {
    "node": ">=18",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "git",
    "cli",
    "conventional-commits"
  ],
  "license": "MIT"
}
